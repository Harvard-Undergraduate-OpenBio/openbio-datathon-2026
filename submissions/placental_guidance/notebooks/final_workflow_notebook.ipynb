"""## 6. Read the Results

- `log2FoldChange`: +1 means twice as high in CASE, −1 means half as high
- `padj`: adjusted p-value, smaller means stronger evidence
- `baseMean`: average count, very low values are unreliable

Set your own cutoffs. Try a few values and note how much the number of passing genes changes.
"""

# STEP 6: VOLCANO PLOTS FOR ALL RUNS

PADJ_CUTOFF = 0.05
LFC_CUTOFF = 1

for name, results in all_runs.items():
    print("\n=====", name, "=====")

    # Identify significant genes
    hits = results[
        (results["padj"] < PADJ_CUTOFF) &
        (results["log2FoldChange"].abs() >= LFC_CUTOFF)
    ]

    print(
        f"{len(hits)} genes pass "
        f"({(hits['log2FoldChange'] > 0).sum()} higher in PE, "
        f"{(hits['log2FoldChange'] < 0).sum()} lower)"
    )

    # Volcano plot for this run
    fig, ax = plt.subplots(figsize=(7, 5))

    ax.scatter(
        results["log2FoldChange"],
        -np.log10(results["padj"].clip(lower=1e-300)),
        s=4,
        color="lightgray"
    )

    ax.scatter(
        hits["log2FoldChange"],
        -np.log10(hits["padj"].clip(lower=1e-300)),
        s=6,
        color="crimson",
        label=f"{len(hits)} passing genes"
    )

    ax.axhline(-np.log10(PADJ_CUTOFF), ls="--", lw=0.8, color="black")
    ax.set_xlabel("log2 fold change (PE vs no PE)")
    ax.set_ylabel("-log10 adjusted p-value")
    ax.set_title(runs[name]["title"])
    ax.legend()

    plt.tight_layout()
    fig.savefig(RESULTS_DIR / f"volcano_{name}.png", dpi=300)
    plt.show()

"""## 7. Connect Genes to Cell Types

First, check which passing genes are known markers of broad placental cell types. If many markers of one cell type move in the same direction, a change in cell mix is one possible explanation.

Gene identifiers in the counts table may not be gene symbols. If no genes match, check the data dictionary for how to map them.
"""

markers = pd.read_csv(DATA_DIR / "interpretation" / "track01_marker_matrix.csv")

if hits is not None:
    overlap = markers.merge(hits[["log2FoldChange", "padj"]], left_on="gene_symbol", right_index=True)
    if overlap.empty:
        print("None of your passing genes are in the marker table.")
    else:
        display(overlap.sort_values(["cell_class", "log2FoldChange"]))
else:
    print("Marker table loaded:", markers["cell_class"].nunique(), "cell classes. Set cutoffs in Section 6 to compare.")

res_c = all_runs["C_ga34"]
all_markers = markers.merge(res_c[["baseMean", "log2FoldChange", "padj"]],
                            left_on="gene_symbol", right_index=True, how="left")
all_markers["passes"] = (all_markers["padj"] < PADJ_CUTOFF) & (all_markers["log2FoldChange"].abs() >= LFC_CUTOFF)
all_markers.to_csv(RESULTS_DIR / "marker_genes_runC.csv", index=False)

summary = all_markers.groupby("cell_class").agg(
    median_log2FC=("log2FoldChange", "median"),
    markers_up=("log2FoldChange", lambda x: int((x > 0).sum())),
    markers_down=("log2FoldChange", lambda x: int((x < 0).sum())),
    markers_passing=("passes", "sum"),
).round(2)
summary

