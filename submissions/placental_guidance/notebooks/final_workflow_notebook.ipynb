"""## 4. Choose a Comparison

Define the two groups you will compare. Use exact column names and values from the metadata table (Section 2 lists them).

- `GROUP_COLUMN`: the column that defines your groups
- `CASE` and `CONTROL`: the two values of that column to compare
- `COVARIATES`: other columns to account for, such as gestational age. Leave as `[]` for none.

Write a short justification for these choices in your analysis plan.
"""

# STEP 4: BUILD COMPARISONS FOR ALL RUNS

# You decide
GROUP_COLUMN = "pe_status"
CASE = "PE"
CONTROL = "no_PE"

runs = {
    "A_naive": {
        "covariates": [],
        "rows": metadata["ga_delivery_weeks"] > 0,
        "title": "Run A: all weeks, no adjustment"
    },
    "B_adjusted": {
        "covariates": ["ga_delivery_weeks", "fetal_sex"],
        "rows": metadata["ga_delivery_weeks"] > 0,
        "title": "Run B: all weeks, adjusted for GA and sex"
    },
    #preterm:
    "C_ga34": {
        "covariates": ["ga_delivery_weeks", "fetal_sex"],
        "rows": (metadata["ga_delivery_weeks"] > 0) & (metadata["ga_delivery_weeks"] <= 34),
        "title": "Run C: 34 weeks or earlier, adjusted for GA and sex"
    },
}


def build_comparison(counts, metadata):
    if None in (GROUP_COLUMN, CASE, CONTROL):
        print("Fill in GROUP_COLUMN, CASE and CONTROL above, then rerun this cell.")
        return None, None

    used = [GROUP_COLUMN] + list(COVARIATES)
    meta = metadata[metadata[GROUP_COLUMN].isin([CASE, CONTROL])][used].copy()

    n_before = len(meta)
    meta = meta.dropna()

    if len(meta) < n_before:
        print(f"Note: {n_before - len(meta)} sample(s) dropped for missing values in {used}. Report this.")

    meta[GROUP_COLUMN] = meta[GROUP_COLUMN].astype(str)
    print(meta[GROUP_COLUMN].value_counts().to_string())

    return counts.loc[:, meta.index], meta


# Build each comparison
comparisons = {}

for name, run in runs.items():
    print("\n=====", name, "=====")

    COVARIATES = run["covariates"]

    comp_counts, comp_meta = (None, None) if counts is None else build_comparison(
        counts,
        metadata.loc[run["rows"]]
    )

    comparisons[name] = {
        "counts": comp_counts,
        "metadata": comp_meta,
        "covariates": COVARIATES,
        "title": run["title"]
    }

    if comp_meta is not None:
        print(f"Samples retained: {len(comp_meta)}")

"""##5. Run the Test
Runs differential expression with PyDESeq2. It adjusts for sequencing depth, then tests every gene for a difference between `CASE` and `CONTROL` that is larger than the natural variation between samples. Expect a few seconds to a few minutes.
"""

# STEP 5: RUN DESEQ2 FOR ALL COMPARISONS

from pydeseq2.dds import DeseqDataSet
from pydeseq2.ds import DeseqStats

all_runs = {}

for name, run in comparisons.items():
    print("\n=====", name, "=====")

    comp_counts = run["counts"]
    comp_meta = run["metadata"]
    COVARIATES = run["covariates"]

    results = None

    if comp_counts is not None:
        design = "~" + " + ".join(list(COVARIATES) + [GROUP_COLUMN])
        print("Design:", design)

        dds = DeseqDataSet(
            counts=comp_counts.T.astype(int),   # PyDESeq2 wants samples as rows
            metadata=comp_meta,
            design=design,
            quiet=True,
        )

        dds.deseq2()

        stats = DeseqStats(
            dds,
            contrast=[GROUP_COLUMN, str(CASE), str(CONTROL)],
            quiet=True
        )

        stats.summary()
        results = stats.results_df.sort_values("padj")

        all_runs[name] = results

        results.to_csv(RESULTS_DIR / f"de_results_{name}.csv")

        print(f"Tested {len(results):,} genes. Saved to results/de_results_{name}.csv")

        display(results.head(20))

